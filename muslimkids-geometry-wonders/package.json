    "@remotion/renderer": "4.0.532",
    "@remotion/three": "4.0.532",
    "d3-geo": "3.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.532",
    "three": "0.180.0",
    "topojson-client": "3.1.0",
