# BalaGo Video Studio — только ИМЕНА переменных. Настоящие значения задаются
# в Vercel → Project → Settings → Environment Variables (или в локальном .env.local,
# который не коммитится). Никогда не вписывайте реальные ключи в этот файл.

# Адрес Studio (точно как в браузере, без пути): https://balago-studio.vercel.app
STUDIO_PUBLIC_URL=http://localhost:3000

# Единственный владелец: логин GitHub и (рекомендуется) числовой id аккаунта.
# id: https://api.github.com/users/<логин> → поле "id".
STUDIO_ALLOWED_GITHUB_LOGIN=adiletzainidinov
STUDIO_ALLOWED_GITHUB_ID=

# GitHub OAuth App (вход владельца). Callback: <STUDIO_PUBLIC_URL>/api/auth/callback
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Случайная строка ≥ 32 символов: openssl rand -base64 48
AUTH_SECRET=

# Приватный Cloudflare R2 (API-токен Object Read & Write только на этот бакет).
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Fine-grained GitHub token только на репозиторий balago-video: Issues — Read and write,
# Contents — Read-only, Metadata — Read-only. Либо серверная GitHub App.
STUDIO_GITHUB_TOKEN=
STUDIO_GITHUB_REPO=adiletzainidinov/balago-video

# Ограничения (необязательно). Максимум загрузки — 250 МБ по умолчанию.
STUDIO_MAX_UPLOAD_BYTES=262144000
# Первый номер для новых карточек (LIVE-001…LIVE-004 уже существуют).
STUDIO_FIRST_LIVE_NUMBER=5
