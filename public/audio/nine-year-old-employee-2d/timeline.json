  "segments": [
    {
      "id": "N01",
      "role": "narrator",
      "mode": "narration",
      "scene": "letter",
      "text": "Уулу атасынын үстөлүнө арыз койду. Анда эртерээк кетүүгө уруксат сураган. Бала болгону тогуз жашта эле.",
      "file": "n01.mp3",
      "voice": "KG-teacher",
      "durationSec": 8,
      "from": 1.3,
      "to": 8.85,
      "action": "рука кладёт лист; «АРЫЗ», текст просьбы; «9 ЖАШ» на «тогуз»"
    },
    {
      "id": "N02",
      "role": "narrator",
      "mode": "narration",
      "scene": "parents",
      "text": "Атасы чакан IT-компанияны жетектейт. Апасы — тиш доктуру. Түштөн кийин ал бейтаптарды кабыл алат.",
      "file": "n02.mp3",
      "voice": "KG-teacher",
      "durationSec": 7.5,
      "from": 12.267,
      "to": 19.597,
      "action": "IT-офис папы → кабинет мамы, подписи"
    },
    {
      "id": "N03",
      "role": "narrator",
      "mode": "narration",
      "scene": "route",
      "text": "Кеңсе мектепке жакын. Атасы уулун ошол жакка алып келет. Үйгө жеткирип, кайра кайтуу жумуштан көпкө алаксытат.",
      "file": "n03.mp3",
      "voice": "KG-teacher",
      "durationSec": 7.95,
      "from": 21.4,
      "to": 29.07,
      "action": "схема Мектеп / Кеңсе / Үй, линии пути"
    },
    {
      "id": "N04",
      "role": "narrator",
      "mode": "narration",
      "scene": "helper",
      "text": "Кеңседегилер баланы жакшы көрүшөт. Терезенин жанына үстөл коюп беришкен. Тамашалап, ага бейдж да жасап беришкен.",
      "file": "n04.mp3",
      "voice": "KG-teacher",
      "durationSec": 7.76,
      "from": 41.1,
      "to": 48.548,
      "action": "коллега здоровается; стол у окна; бейдж"
    },
    {
      "id": "N05",
      "role": "narrator",
      "mode": "narration",
      "scene": "helper",
      "text": "Ал үй тапшырмасын аткарат, сүрөт тартат. Атасы уулуна бул жер жагат деп ойлойт.",
      "file": "n05.mp3",
      "voice": "KG-teacher",
      "durationSec": 5.83,
      "from": 49.048,
      "to": 54.638,
      "action": "задание, рисунок, листы в переговорной; взгляд отца"
    },
    {
      "id": "F01",
      "role": "father",
      "mode": "live",
      "scene": "quit",
      "text": "Жумуштан кетүүнү чечтиңби?",
      "file": "f01.mp3",
      "voice": "KG-husband",
      "durationSec": 1.71,
      "from": 61.867,
      "to": 63.235,
      "action": "папа берёт лист, читает, улыбается"
    },
    {
      "id": "S01",
      "role": "son",
      "mode": "live",
      "scene": "quit",
      "text": "Жок. Болгону эртерээк кетким келет.",
      "file": "s01.mp3",
      "voice": "KG-boy a2-3",
      "durationSec": 2.06,
      "from": 64.135,
      "to": 66.055,
      "action": "сын качает головой"
    },
    {
      "id": "F02",
      "role": "father",
      "mode": "live",
      "scene": "quit",
      "text": "Эмне болду?",
      "file": "f02.mp3",
      "voice": "KG-husband",
      "durationSec": 0.98,
      "from": 67.255,
      "to": 67.905,
      "action": "папа откладывает лист, смотрит на сына"
    },
    {
      "id": "S02",
      "role": "son",
      "mode": "live",
      "scene": "ship",
      "text": "Досторум дүйшөмбүдө кеме жасай башташкан. Кечээ капитандын бөлмөсүн бүтүрүшүптүр. Мен да жардам бергим келген.",
      "file": "s02.mp3",
      "voice": "KG-boy a2-3",
      "durationSec": 6.3,
      "from": 73.333,
      "to": 79.413,
      "action": "фото в руках отца; воспоминание: друзья и корабль"
    },
    {
      "id": "F03",
      "role": "father",
      "mode": "live",
      "scene": "badge",
      "text": "Айтсаң болмок да.",
      "file": "f03.mp3",
      "voice": "KG-husband",
      "durationSec": 1.2,
      "from": 82.333,
      "to": 83.221,
      "action": "папа поднимает взгляд от фото"
    },
    {
      "id": "S03",
      "role": "son",
      "mode": "live",
      "scene": "badge",
      "text": "Кечээ бейджимди көрсөтүп, жардамчымсың дедиң. Мен бул жерде болсом, сен кубанасың деп ойлогом.",
      "file": "s03.mp3",
      "voice": "KG-boy a2-3",
      "durationSec": 5.7,
      "from": 84.221,
      "to": 89.661,
      "action": "сын касается бейджа; вставка вчерашнего жеста"
    },
    {
      "id": "F04",
      "role": "father",
      "mode": "live",
      "scene": "badge",
      "text": "Сени менен бирге болуу мага абдан жагат. Кеме тууралуу да баарын уккум келет.",
      "file": "f04.mp3",
      "voice": "KG-husband",
      "durationSec": 5.06,
      "from": 96.061,
      "to": 100.789,
      "action": "папа встаёт, обходит стол, садится рядом; говорит сидя"
    },
    {
      "id": "N06",
      "role": "narrator",
      "mode": "narration",
      "scene": "early",
      "text": "Ошол күнү атасы жумушун эртерээк бүтүрдү.",
      "file": "n06.mp3",
      "voice": "KG-teacher",
      "durationSec": 3.217,
      "from": 106,
      "to": 109.067,
      "action": "папа закрывает ноутбук, берёт ключи"
    },
    {
      "id": "N07",
      "role": "narrator",
      "mode": "narration",
      "scene": "yard",
      "text": "Үйгө келишти. Уулу короого чуркады. Атасы балдарга кеменин мачтасын бекемдөөгө жардам берди.",
      "file": "n07.mp3",
      "voice": "KG-teacher",
      "durationSec": 8.17,
      "from": 113.1,
      "to": 120.94,
      "action": "машина у дома, выход, бег к кораблю"
    },
    {
      "id": "S04",
      "role": "son",
      "mode": "live",
      "scene": "yard",
      "text": "Мен да жардам берем!",
      "file": "s04.mp3",
      "voice": "KG-boy a2-3",
      "durationSec": 1.16,
      "from": 121.44,
      "to": 122.413,
      "action": "сын остановился у друзей"
    },
    {
      "id": "F05",
      "role": "father",
      "mode": "live",
      "scene": "evening",
      "text": "Үйгө эртерээк келгиси келиптир. Бирок күн сайын жеткирип, кайра кеңсеге кайтуу кыйын.",
      "file": "f05.mp3",
      "voice": "KG-husband",
      "durationSec": 5.27,
      "from": 130.433,
      "to": 135.393,
      "action": "родители за столом, телефон мамы на столе"
    },
    {
      "id": "M01",
      "role": "mother",
      "mode": "live",
      "scene": "evening",
      "text": "Үйдө чоң апасы тосуп алат. Балдар үчүн такси издеп көрөлү.",
      "file": "m01.mp3",
      "voice": "KG-mother",
      "durationSec": 4.09,
      "from": 136.093,
      "to": 139.893,
      "action": "мама берёт телефон"
    },
    {
      "id": "M02",
      "role": "mother",
      "mode": "live",
      "scene": "balago",
      "text": "Мына, BalaGo. Алдын ала арыз кабыл алып жатышыптыр.",
      "file": "m02.mp3",
      "voice": "KG-mother",
      "durationSec": 3.56,
      "from": 145.5,
      "to": 148.77,
      "action": "поиск «Балдар үчүн такси», страница BalaGo"
    },
    {
      "id": "F06",
      "role": "father",
      "mode": "live",
      "scene": "balago",
      "text": "Мектептен үйгө алып келүү тууралуу сурап көрөлү.",
      "file": "f06.mp3",
      "voice": "KG-husband",
      "durationSec": 2.55,
      "from": 149.57,
      "to": 151.97,
      "action": "папа смотрит на экран, выбирает «Мектеп → Үй»"
    },
    {
      "id": "M03",
      "role": "mother",
      "mode": "live",
      "scene": "balago",
      "text": "Макул. Мектебин, үйдүн дарегин, сабак бүткөн убакытты жазалы.",
      "file": "m03.mp3",
      "voice": "KG-mother",
      "durationSec": 5.15,
      "from": 152.57,
      "to": 157.52,
      "action": "форма: Мектеп, Үй, 14:30"
    },
    {
      "id": "N08",
      "role": "narrator",
      "mode": "narration",
      "scene": "drawing",
      "text": "Уктаар алдында уулу бейджин чечип, үстөлүнүн жогору жагына илип койду. Жанына кеменин сүрөтүн койду. Кеменин тумшугуна өзүн тартыптыр.",
      "file": "n08.mp3",
      "voice": "KG-teacher",
      "durationSec": 9.59,
      "from": 163.333,
      "to": 172.621,
      "action": "снимает бейдж, вешает; придвигает рисунок"
    }
  ]
}
