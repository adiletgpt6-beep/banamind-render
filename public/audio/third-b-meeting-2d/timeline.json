  "segments": [
    {
      "id": "C01a",
      "line": "C01",
      "role": "client",
      "mode": "live",
      "scene": "hook",
      "text": "Кечиресиз… Сиз азыр үчүнчү «Б» класстасызбы?",
      "file": "c01.mp3",
      "voice": "NB2-brother",
      "durationSec": 3.13,
      "from": 0.7,
      "to": 3.51,
      "action": "крупный план клиента в окне звонка; мама замирает, край листа «3 Б»"
    },
    {
      "id": "N01",
      "line": "N01",
      "role": "narrator",
      "mode": "narration",
      "scene": "studio",
      "text": "Айжан дизайн студиясын жетектейт. Бүгүн ал кардарларга жаңы долбоорун көрсөтмөк. Презентация, эсептөөлөр, материалдардын үлгүлөрү — баары даяр.",
      "file": "n01.mp3",
      "voice": "KG-teacher",
      "durationSec": 9.84,
      "from": 7.033,
      "to": 16.633,
      "action": "студия «АЙКЫН»: образцы выравниваются, эскиз «БУЛАК», слайд, список"
    },
    {
      "id": "N02",
      "line": "N02",
      "role": "narrator",
      "mode": "narration",
      "scene": "calendar",
      "text": "Бирок эртең менен кардарлар жолугушууну башка убакытка жылдырышты. Дал ошол маалда кызынын сабагы бүтөт.",
      "file": "n02.mp3",
      "voice": "KG-teacher",
      "durationSec": 7.67,
      "from": 21.333,
      "to": 28.763,
      "action": "сообщение клиента прочитано; встреча 11:00 → 13:30 рядом с уроками"
    },
    {
      "id": "F01",
      "line": "F01",
      "role": "father",
      "mode": "live",
      "scene": "dad",
      "text": "Бүгүн кызматкерлерди окутуп жатам. Тилекке каршы, чыга албайм.",
      "file": "f01.mp3",
      "voice": "KG-husband",
      "durationSec": 4.07,
      "from": 32.267,
      "to": 36.107,
      "action": "папа на обучении сотрудников, телефон у уха"
    },
    {
      "id": "M01",
      "line": "M01",
      "role": "mother",
      "mode": "live",
      "scene": "dad",
      "text": "Түшүндүм.",
      "file": "m01.mp3",
      "voice": "KG-mother",
      "durationSec": 0.93,
      "from": 36.707,
      "to": 37.275,
      "action": "мама кивает, смотрит на папку, берёт ключи"
    },
    {
      "id": "N03",
      "line": "N03",
      "role": "narrator",
      "mode": "narration",
      "scene": "parked",
      "text": "Айжан мектепке эрте келип, унаадагы жолугушууга даярданды.",
      "file": "n03.mp3",
      "voice": "KG-teacher",
      "durationSec": 4.14,
      "from": 41,
      "to": 44.66,
      "action": "машина у школы; мама пересаживается назад влево с ноутбуком"
    },
    {
      "id": "M02",
      "line": "M02",
      "role": "mother",
      "mode": "live",
      "scene": "daughter",
      "text": "Мен сүйлөшүп бүтөйүн. Анан үйгө кетебиз.",
      "file": "m02.mp3",
      "voice": "KG-mother",
      "durationSec": 2.72,
      "from": 65,
      "to": 67.36,
      "action": "дочка вышла, открыла дверь, села; мама проверяет ремень"
    },
    {
      "id": "G01",
      "line": "G01",
      "role": "daughter",
      "mode": "live",
      "scene": "daughter",
      "text": "Макул.",
      "file": "g01.mp3",
      "voice": "KG-daughter",
      "durationSec": 0.61,
      "from": 67.86,
      "to": 68.23,
      "action": "дочка кивает"
    },
    {
      "id": "M03",
      "line": "M03",
      "role": "mother",
      "mode": "live",
      "scene": "present",
      "text": "Бул вариантта аталыш алыстан да жакшы окулат. Материалдардын үлгүлөрүн да даярдадым.",
      "file": "m03.mp3",
      "voice": "KG-mother",
      "durationSec": 5.98,
      "from": 71.633,
      "to": 77.293,
      "action": "звонок идёт; мама жестом к образцу; варианты «БУЛАК»"
    },
    {
      "id": "C01",
      "line": "C01",
      "role": "client",
      "mode": "live",
      "scene": "joke",
      "text": "Кечиресиз… Сиз азыр үчүнчү «Б» класстасызбы?",
      "file": "c01.mp3",
      "voice": "NB2-brother",
      "durationSec": 3.13,
      "from": 92,
      "to": 94.81,
      "action": "лист в окне звонка; тот же файл, что в сцене 1"
    },
    {
      "id": "M04",
      "line": "M04",
      "role": "mother",
      "mode": "live",
      "scene": "joke",
      "text": "Бүгүн көчмө кеңседебиз. Бул — менин кызым.",
      "file": "m04.mp3",
      "voice": "KG-mother",
      "durationSec": 3.14,
      "from": 95.81,
      "to": 98.618,
      "action": "мама замирает, смотрит на рисунок, улыбается"
    },
    {
      "id": "C02",
      "line": "C02",
      "role": "client",
      "mode": "live",
      "scene": "joke",
      "text": "Сонун көрнөк экен! Эми сиз даярдаган долбоорду көрөлү.",
      "file": "c02.mp3",
      "voice": "NB2-brother",
      "durationSec": 3.32,
      "from": 99.718,
      "to": 102.808,
      "action": "клиент замечает мальчика с карандашом, улыбается"
    },
    {
      "id": "C03",
      "line": "C03",
      "role": "client",
      "mode": "live",
      "scene": "approved",
      "text": "Ушул вариантты тандайлы. Бизге жакты.",
      "file": "c03.mp3",
      "voice": "NB2-brother",
      "durationSec": 2.2,
      "from": 106.733,
      "to": 108.653,
      "action": "клиент выбирает показанный вариант"
    },
    {
      "id": "M05",
      "line": "M05",
      "role": "mother",
      "mode": "live",
      "scene": "approved",
      "text": "Рахмат. Анда ушул вариант менен улантабыз.",
      "file": "m05.mp3",
      "voice": "KG-mother",
      "durationSec": 2.84,
      "from": 109.153,
      "to": 111.873,
      "action": "мама подтверждает; тачпад, конец звонка, крышка"
    },
    {
      "id": "G02",
      "line": "G02",
      "role": "daughter",
      "mode": "live",
      "scene": "question",
      "text": "Апа, сүрөтүм тоскоол болгон жокпу?",
      "file": "g02.mp3",
      "voice": "KG-daughter",
      "durationSec": 2.32,
      "from": 117.9,
      "to": 119.91,
      "action": "тихий средний план, лицо дочки"
    },
    {
      "id": "M06",
      "line": "M06",
      "role": "mother",
      "mode": "live",
      "scene": "question",
      "text": "Жок, кызым. Баарына жакты.",
      "file": "m06.mp3",
      "voice": "KG-mother",
      "durationSec": 2.17,
      "from": 120.91,
      "to": 122.758,
      "action": "мама оставляет ноутбук, смотрит на дочь"
    },
    {
      "id": "N04",
      "line": "N04",
      "role": "narrator",
      "mode": "narration",
      "scene": "drive",
      "text": "Бүгүн баарына жетишти. Бирок ар бир жолугушууну мектептин жанында өткөрүү оңой эмес.",
      "file": "n04.mp3",
      "voice": "KG-teacher",
      "durationSec": 5.8,
      "from": 131.1,
      "to": 136.7,
      "action": "мама за рулём, ремни; машина едет домой"
    },
    {
      "id": "M07",
      "line": "M07",
      "role": "mother",
      "mode": "live",
      "scene": "search",
      "text": "Бүгүн жолугушуу жакшы өттү. Бирок күн сайын ушинтип иштей албайм.",
      "file": "m07.mp3",
      "voice": "KG-mother",
      "durationSec": 4.68,
      "from": 140.7,
      "to": 145.18,
      "action": "вечер, родители за столом, дочка с альбомом"
    },
    {
      "id": "F02",
      "line": "F02",
      "role": "father",
      "mode": "live",
      "scene": "search",
      "text": "Кел, мектепке барып-келүүнүн башка жолун издеп көрөлү.",
      "file": "f02.mp3",
      "voice": "KG-husband",
      "durationSec": 3.367,
      "from": 145.78,
      "to": 148.997,
      "action": "папа берёт телефон"
    },
    {
      "id": "M08",
      "line": "M08",
      "role": "mother",
      "mode": "live",
      "scene": "search",
      "text": "Мына, BalaGo. Алдын ала арыз калтырсак болот экен.",
      "file": "m08.mp3",
      "voice": "KG-mother",
      "durationSec": 3.48,
      "from": 154.397,
      "to": 157.637,
      "action": "поиск, результат, страница BalaGo, «Мектеп → Үй»"
    },
    {
      "id": "F03",
      "line": "F03",
      "role": "father",
      "mode": "live",
      "scene": "search",
      "text": "Кел, кайрылып, каттам тууралуу сүйлөшөлү.",
      "file": "f03.mp3",
      "voice": "KG-husband",
      "durationSec": 2.99,
      "from": 158.337,
      "to": 161.057,
      "action": "WhatsApp: предварительное обращение, «Жөнөтүлдү»"
    },
    {
      "id": "G03",
      "line": "G03",
      "role": "daughter",
      "mode": "live",
      "scene": "sign",
      "text": "Апа, кабинетиңе да көрнөк жасап берейинби?",
      "file": "g03.mp3",
      "voice": "KG-daughter",
      "durationSec": 2.64,
      "from": 167.967,
      "to": 170.143,
      "action": "дочка подходит с альбомом"
    },
    {
      "id": "M09",
      "line": "M09",
      "role": "mother",
      "mode": "live",
      "scene": "sign",
      "text": "Кел, чогуу жасайлы.",
      "file": "m09.mp3",
      "voice": "KG-mother",
      "durationSec": 1.75,
      "from": 170.743,
      "to": 172.191,
      "action": "мама поворачивается; «АЙКЫН», «Дизайнер — 3 Б»"
    }
  ]
