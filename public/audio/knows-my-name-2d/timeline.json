  "segments": [
    {
      "id": "N01",
      "role": "narrator",
      "mode": "narration",
      "scene": "hook",
      "text": "Ата-энеси даректи, убакытты, каттамды талкуулап жатышты. Уулунун суроосу башкача болду.",
      "file": "n01.mp3",
      "voice": "KG-teacher",
      "durationSec": 6.47,
      "from": 0.5,
      "to": 6.673,
      "action": "телефон «Мектеп → Үй», ручка дописывает «Каттам»; камера к сыну"
    },
    {
      "id": "K01",
      "role": "boy",
      "mode": "live",
      "scene": "hook",
      "text": "Ал менин атымды билеби?",
      "file": "k01.mp3",
      "voice": "KG-son v7 remix-2",
      "durationSec": 1.59,
      "from": 7.373,
      "to": 8.653,
      "action": "сын у края стола спрашивает; мама поднимает взгляд от телефона"
    },
    {
      "id": "N02",
      "role": "narrator",
      "mode": "narration",
      "scene": "work",
      "text": "Апасы компанияда бөлүм жетектейт. Атасы IT тармагында иштейт. Машинасы бар. Бирок мектептен кийин уулун алып келүү үчүн жумуштагы жолугушуулардын арасынан убакыт табышат.",
      "file": "n02.mp3",
      "voice": "KG-teacher",
      "durationSec": 12.18,
      "from": 11.567,
      "to": 23.527,
      "action": "мама обсуждает документ с коллегой; папа за ноутбуком переносит запись"
    },
    {
      "id": "N03",
      "role": "narrator",
      "mode": "narration",
      "scene": "nanny",
      "text": "Үйдө уулун нянясы тосуп ала алат. Ал кичинекей карындашын да карайт. Кыйынчылык — баланы күн сайын мектептен алып, үйгө жеткирүүдө.",
      "file": "n03.mp3",
      "voice": "KG-teacher",
      "durationSec": 8.88,
      "from": 25.833,
      "to": 34.513,
      "action": "няня и сестрёнка с кубиками; мальчик входит, вешает рюкзак, няня машет"
    },
    {
      "id": "N04",
      "role": "narrator",
      "mode": "narration",
      "scene": "evening",
      "text": "Кечинде ата-эне мектептен үйгө жеткирүүнүн жолун издеди. Уулу алардын сөзүн угуп калды.",
      "file": "n04.mp3",
      "voice": "KG-teacher",
      "durationSec": 6.33,
      "from": 36.933,
      "to": 42.983,
      "action": "«Кечинде»: тот же стол, поиск «Мектептен үйгө жеткирүү»; сын подходит"
    },
    {
      "id": "K02",
      "role": "boy",
      "mode": "live",
      "scene": "evening",
      "text": "Эми мени башка киши алып кетеби?",
      "file": "k02.mp3",
      "voice": "KG-son v7 remix-2",
      "durationSec": 2.13,
      "from": 43.583,
      "to": 45.413,
      "action": "сын спрашивает у края стола"
    },
    {
      "id": "F01",
      "role": "father",
      "mode": "live",
      "scene": "evening",
      "text": "Биз азырынча муну кантип уюштурса болорун карап жатабыз.",
      "file": "f01.mp3",
      "voice": "KG-husband",
      "durationSec": 3.54,
      "from": 46.113,
      "to": 49.373,
      "action": "папа переводит взгляд, поворачивается к сыну, отвечает"
    },
    {
      "id": "M01",
      "role": "mother",
      "mode": "live",
      "scene": "phoneDown",
      "text": "Жолго чыгардан мурда таанышып, баарын сүйлөшөбүз. Сен да таанышасың.",
      "file": "m01.mp3",
      "voice": "KG-mother",
      "durationSec": 4.769,
      "from": 52.7,
      "to": 56.879,
      "action": "тот же план вопроса; мама кладёт телефон экраном вниз, отвечает"
    },
    {
      "id": "K03",
      "role": "boy",
      "mode": "live",
      "scene": "thirdB",
      "text": "Анда мен үчүнчү «Б» класста окуйм деп айткыла. Спорт залда сабак болгондо, биз башка эшиктен чыгабыз.",
      "file": "k03.mp3",
      "voice": "KG-son v7 remix-2",
      "durationSec": 6.52,
      "from": 59.8,
      "to": 66.04,
      "action": "папа готовит ручку; сын объясняет, показывает дверь на рисунке"
    },
    {
      "id": "N05",
      "role": "narrator",
      "mode": "narration",
      "scene": "balago",
      "text": "Ата-энеси BalaGo тууралуу маалымат тапты. Адилет беш миңден ашык сапар жасаган. Балдар менен иштеп, аларга араб тилин үйрөткөн.",
      "file": "n05.mp3",
      "voice": "KG-teacher",
      "durationSec": 9.03,
      "from": 70.467,
      "to": 79.267,
      "action": "мама берёт тот же телефон: поиск → BalaGo → Адилет; папа наклоняется"
    },
    {
      "id": "M02",
      "role": "mother",
      "mode": "live",
      "scene": "balago",
      "text": "Аны менен сүйлөшкүм келет. Биздин каттамды, баланы мектептен кантип тосуп аларын тактап алалы.",
      "file": "m02.mp3",
      "voice": "KG-mother",
      "durationSec": 6.16,
      "from": 80.067,
      "to": 85.987,
      "action": "мама поворачивается от телефона к папе"
    },
    {
      "id": "N06",
      "role": "narrator",
      "mode": "narration",
      "scene": "request",
      "text": "Алар алдын ала өтүнмө калтырышты. Блокнотко сабактын убактысын, кайсы эшиктен чыгарын, үйдө ким тосуп аларын жана сапарга чейин таанышууну жазышты.",
      "file": "n06.mp3",
      "voice": "KG-teacher",
      "durationSec": 10.82,
      "from": 88,
      "to": 98.56,
      "action": "форма заявки → нажатие → «жөнөтүлдү»; строки вопросов в блокноте"
    },
    {
      "id": "K04",
      "role": "boy",
      "mode": "live",
      "scene": "toyCar",
      "text": "Дагы сурагылачы, машинкамды кошо алсам болобу?",
      "file": "k04.mp3",
      "voice": "KG-son v7 remix-2",
      "durationSec": 3.3,
      "from": 102.967,
      "to": 105.977,
      "action": "сын берёт машинку с полки, приносит, показывает"
    },
    {
      "id": "N07",
      "role": "narrator",
      "mode": "narration",
      "scene": "toyCar",
      "text": "Атасы бул суроону да тизмеге кошту.",
      "file": "n07.mp3",
      "voice": "KG-teacher",
      "durationSec": 2.79,
      "from": 106.677,
      "to": 109.173,
      "action": "папа записывает «Машинкасын алса болобу?»; мама улыбается"
    },
    {
      "id": "N08",
      "role": "narrator",
      "mode": "narration",
      "scene": "morning",
      "text": "Эртеси уулун мектепке атасы өзү жеткирди. Дарбазанын жанында рюкзагын түздөп берди.",
      "file": "n08.mp3",
      "voice": "KG-teacher",
      "durationSec": 6.24,
      "from": 113.4,
      "to": 119.4,
      "action": "«Эртеси эртең менен»: машина семьи у школы; папа поправляет лямку"
    },
    {
      "id": "K05",
      "role": "boy",
      "mode": "live",
      "scene": "introduce",
      "text": "Таанышканда, атымды өзүм айтсам болобу?",
      "file": "k05.mp3",
      "voice": "KG-son v7 remix-2",
      "durationSec": 2.8,
      "from": 123.233,
      "to": 125.713,
      "action": "крупно сын: думает, улыбается, спрашивает"
    },
    {
      "id": "F02",
      "role": "father",
      "mode": "live",
      "scene": "introduce",
      "text": "Албетте. Машинкаң тууралуу да айтып бересиң.",
      "file": "f02.mp3",
      "voice": "KG-husband",
      "durationSec": 2.59,
      "from": 126.413,
      "to": 128.645,
      "action": "папа на уровне сына отвечает; сын кивает"
    },
    {
      "id": "N09",
      "role": "narrator",
      "mode": "narration",
      "scene": "contact",
      "text": "BalaGo. Балдар үчүн такси.",
      "file": "n09.mp3",
      "voice": "KG-teacher",
      "durationSec": 2.12,
      "from": 136.833,
      "to": 138.673,
      "action": "контактная карточка BalaGo"
    }
  ]
}
