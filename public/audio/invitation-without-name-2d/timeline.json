  "segments": [
    {
      "id": "T01",
      "role": "teacher",
      "mode": "live",
      "scene": "hook",
      "text": "Уулуңуз сиздин келишиңизди аябай каалаган.",
      "file": "t01.mp3",
      "voice": "KG-friend",
      "durationSec": 2.84,
      "from": 0.7,
      "to": 3.196,
      "action": "учительница у кабинета 203 обращается к папе"
    },
    {
      "id": "F01",
      "role": "father",
      "mode": "live",
      "scene": "hook",
      "text": "Эмнеге мага айткан жок?",
      "file": "f01.mp3",
      "voice": "KG-husband",
      "durationSec": 1.45,
      "from": 4.196,
      "to": 5.403,
      "action": "взгляд папы меняется; крупно — удивление"
    },
    {
      "id": "N01",
      "role": "narrator",
      "mode": "narration",
      "scene": "blank",
      "text": "Бирок чакыруу кагазы бир жума бою сумкасында жатты. Аты-жөнү жазыла турган сап бош эле.",
      "file": "n01.mp3",
      "voice": "KG-teacher",
      "durationSec": 6.45,
      "from": 8.433,
      "to": 14.523,
      "action": "строки приглашения по очереди; пустая строка гостя; «Бир жума»"
    },
    {
      "id": "N02",
      "role": "narrator",
      "mode": "narration",
      "scene": "careers",
      "text": "Мектепте кесиптер күнү өтмөк. Ата-энелер балдарга өз иши тууралуу айтып беришмек.",
      "file": "n02.mp3",
      "voice": "KG-teacher",
      "durationSec": 5.57,
      "from": 16.733,
      "to": 22.083,
      "action": "доска «КЕСИПТЕР КҮНҮ», предметы профессий; учительница раздаёт листы"
    },
    {
      "id": "N03",
      "role": "narrator",
      "mode": "narration",
      "scene": "proud",
      "text": "Атасы — инженер. Эмир анын чиймелерин кызыгуу менен карачу.",
      "file": "n03.mp3",
      "voice": "KG-teacher",
      "durationSec": 4.68,
      "from": 23.8,
      "to": 28.13,
      "action": "папа над чертежом; Эмир рассматривает линии"
    },
    {
      "id": "S01",
      "role": "son",
      "mode": "live",
      "scene": "proud",
      "text": "Менин атам чыныгы имараттарды долбоорлойт!",
      "file": "s01.mp3",
      "voice": "KG-boy a2-3",
      "durationSec": 2.63,
      "from": 29.53,
      "to": 31.858,
      "action": "Эмир с двумя одноклассниками; дети реагируют"
    },
    {
      "id": "N04",
      "role": "narrator",
      "mode": "narration",
      "scene": "route",
      "text": "Күн сайын ал уулун мектептен алып, кайра жумушка кайтып барчу.",
      "file": "n04.mp3",
      "voice": "KG-teacher",
      "durationSec": 4.26,
      "from": 34.367,
      "to": 38.367,
      "action": "карандаш отложен → машина у школы → снова за чертежом; линия Кеңсе → Мектеп → Үй → Кеңсе"
    },
    {
      "id": "N05",
      "role": "narrator",
      "mode": "narration",
      "scene": "backpack",
      "text": "Үйдө апасы сумкадан бырышып калган чакыруу кагазын тапты.",
      "file": "n05.mp3",
      "voice": "KG-teacher",
      "durationSec": 4.02,
      "from": 41.267,
      "to": 45.007,
      "action": "молния открыта, рука в рюкзаке, лист на столе"
    },
    {
      "id": "F02",
      "role": "father",
      "mode": "live",
      "scene": "ask",
      "text": "Менин келишимди кааладың беле?",
      "file": "f02.mp3",
      "voice": "KG-husband",
      "durationSec": 1.91,
      "from": 51.233,
      "to": 52.843,
      "action": "папа подходит, отодвигает стул, садится рядом"
    },
    {
      "id": "F03",
      "role": "father",
      "mode": "live",
      "scene": "ask",
      "text": "Анда эмнеге чакырууну бербедиң?",
      "file": "f03.mp3",
      "voice": "KG-husband",
      "durationSec": 2.21,
      "from": 54.843,
      "to": 56.723,
      "action": "сын молча кивает"
    },
    {
      "id": "S02",
      "role": "son",
      "mode": "live",
      "scene": "why",
      "text": "Сен мени мектептен алып кетиш үчүн күн сайын жумуштан чыгасың. Анан кайра жумушка кайтасың. Дагы бир жолу сурансам... ашыкча болуп калат го деп ойлодум.",
      "file": "s02.mp3",
      "voice": "KG-boy a2-3",
      "durationSec": 8.74,
      "from": 59.533,
      "to": 68.013,
      "action": "сын смотрит на лист, затем на папу; общий → крупный сына → реакция папы"
    },
    {
      "id": "F04",
      "role": "father",
      "mode": "live",
      "scene": "idea",
      "text": "Классыңа эмне көрсөтөбүз?",
      "file": "f04.mp3",
      "voice": "KG-husband",
      "durationSec": 1.621,
      "from": 77.233,
      "to": 78.521,
      "action": "папа придвигает заполненное приглашение к сыну"
    },
    {
      "id": "S03",
      "role": "son",
      "mode": "live",
      "scene": "idea",
      "text": "Көпүрө! Кагаздан көпүрө жасасак болобу?",
      "file": "s03.mp3",
      "voice": "KG-boy a2-3",
      "durationSec": 2.96,
      "from": 79.521,
      "to": 82.177,
      "action": "сын выпрямляется, берёт чистый лист; линия пролёта"
    },
    {
      "id": "N06",
      "role": "narrator",
      "mode": "narration",
      "scene": "test",
      "text": "Ошол кечте алар ар кандай көпүрөлөрдү жасап көрүштү. Бирөө ийилип калды. Экинчиси оюнчук машинаны көтөрдү.",
      "file": "n06.mp3",
      "voice": "KG-teacher",
      "durationSec": 8.14,
      "from": 85,
      "to": 92.896,
      "action": "плоский лист прогибается; сгибают второй; машинка проезжает"
    },
    {
      "id": "N07",
      "role": "narrator",
      "mode": "narration",
      "scene": "class",
      "text": "Эртеси Эмир классташтарына атасын тааныштырды.",
      "file": "n07.mp3",
      "voice": "KG-teacher",
      "durationSec": 3.64,
      "from": 103.4,
      "to": 106.76,
      "action": "учительница встречает папу; Эмир показывает, куда поставить модель"
    },
    {
      "id": "F05",
      "role": "father",
      "mode": "live",
      "scene": "class",
      "text": "Инженерлер имараттарды, жолдорду, көпүрөлөрдү долбоорлошот. Бүгүн кагаздан жасалган көпүрөбүздү сынайбыз.",
      "file": "f05.mp3",
      "voice": "KG-husband",
      "durationSec": 7.41,
      "from": 107.96,
      "to": 115.08,
      "action": "папа показывает на чертёж, затем на мост"
    },
    {
      "id": "N08",
      "role": "narrator",
      "mode": "narration",
      "scene": "demo",
      "text": "Кечээги тажрыйба класста да ийгиликтүү өттү.",
      "file": "n08.mp3",
      "voice": "KG-teacher",
      "durationSec": 3.347,
      "from": 122.1,
      "to": 125.255,
      "action": "после проезда машинки и аплодисментов"
    },
    {
      "id": "M01",
      "role": "mother",
      "mode": "live",
      "scene": "parents",
      "text": "Мектепке барып-келүүнү алдын ала уюштуралы. Ошондо жумушубузду да жеңилирээк пландайбыз.",
      "file": "m01.mp3",
      "voice": "KG-mother",
      "durationSec": 6.83,
      "from": 132.067,
      "to": 138.667,
      "action": "родители за столом: фото, телефон, расписание"
    },
    {
      "id": "F06",
      "role": "father",
      "mode": "live",
      "scene": "parents",
      "text": "Макул. Маршрут менен убактысын сүйлөшүп алалы.",
      "file": "f06.mp3",
      "voice": "KG-husband",
      "durationSec": 2.97,
      "from": 139.467,
      "to": 142.187,
      "action": "папа соглашается; мама открывает поиск"
    },
    {
      "id": "N09",
      "role": "narrator",
      "mode": "narration",
      "scene": "balago",
      "text": "Алар BalaGo'ну таап, мектепке барып-келүү убактысын сүйлөшүү үчүн алдын ала өтүнмө калтырышты.",
      "file": "n09.mp3",
      "voice": "KG-teacher",
      "durationSec": 7.02,
      "from": 145.5,
      "to": 152.22,
      "action": "поиск → карточка BalaGo → страница → форма → «Жөнөтүү» → «Өтүнмө жөнөтүлдү»"
    },
    {
      "id": "F07",
      "role": "father",
      "mode": "live",
      "scene": "bedtime",
      "text": "Сактап коёсуңбу?",
      "file": "f07.mp3",
      "voice": "KG-husband",
      "durationSec": 1.25,
      "from": 157.833,
      "to": 158.601,
      "action": "папа подходит к столу сына, видит приглашение и фото"
    },
    {
      "id": "S04",
      "role": "son",
      "mode": "live",
      "scene": "bedtime",
      "text": "Албетте. Бул жерде сенин атың жазылган да.",
      "file": "s04.mp3",
      "voice": "KG-boy a2-3",
      "durationSec": 2.66,
      "from": 159.401,
      "to": 161.861,
      "action": "сын отвечает; папа смотрит на имя и на сына"
    },
    {
      "id": "N10",
      "role": "narrator",
      "mode": "narration",
      "scene": "contact",
      "text": "BalaGo — балдар үчүн такси.",
      "file": "n10.mp3",
      "voice": "KG-teacher",
