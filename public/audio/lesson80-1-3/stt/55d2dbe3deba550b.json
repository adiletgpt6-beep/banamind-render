{"file": "public/audio/lesson80-1-3/raw/be4a13710d00d6.mp3", "id": "80-1-3-010", "take": 1, "model": "whisper-medium", "text": "Ты направил на них воздух. Когда воздух движется, он может вращать вертушку. Хорошо.", "words": [{"text": "Ты", "start": 0.0, "end": 0.24}, {"text": "направил", "start": 0.24, "end": 0.74}, {"text": "на", "start": 0.74, "end": 0.86}, {"text": "них", "start": 0.86, "end": 1.12}, {"text": "воздух.", "start": 1.12, "end": 1.76}, {"text": "Когда", "start": 2.02, "end": 2.26}, {"text": "воздух", "start": 2.26, "end": 2.66}, {"text": "движется,", "start": 2.66, "end": 3.3}, {"text": "он", "start": 3.48, "end": 3.66}, {"text": "может", "start": 3.66, "end": 4.06}, {"text": "вращать", "start": 4.06, "end": 4.46}, {"text": "вертушку.", "start": 4.46, "end": 5.12}, {"text": "Хорошо.", "start": 5.44, "end": 5.78}]}