{"file": "public/audio/lesson80-1-3/raw/5b370b8b0070a8.mp3", "id": "80-1-3-028", "take": 1, "model": "whisper-medium", "text": "Только то, что воздух может двигаться, хотя мы его не видим. А из слов «я не вижу» еще не следует этого нет. Хорошо.", "words": [{"text": "Только", "start": 0.0, "end": 0.48}, {"text": "то,", "start": 0.48, "end": 0.7}, {"text": "что", "start": 0.84, "end": 1.0}, {"text": "воздух", "start": 1.0, "end": 1.46}, {"text": "может", "start": 1.46, "end": 1.72}, {"text": "двигаться,", "start": 1.72, "end": 2.4}, {"text": "хотя", "start": 2.54, "end": 2.78}, {"text": "мы", "start": 2.78, "end": 3.02}, {"text": "его", "start": 3.02, "end": 3.24}, {"text": "не", "start": 3.24, "end": 3.52}, {"text": "видим.", "start": 3.52, "end": 3.8}, {"text": "А", "start": 4.14, "end": 4.26}, {"text": "из", "start": 4.26, "end": 4.46}, {"text": "слов", "start": 4.46, "end": 4.7}, {"text": "«я", "start": 4.7, "end": 5.08}, {"text": "не", "start": 5.08, "end": 5.26}, {"text": "вижу»", "start": 5.26, "end": 5.84}, {"text": "еще", "start": 5.84, "end": 6.1}, {"text": "не", "start": 6.1, "end": 6.34}, {"text": "следует", "start": 6.34, "end": 6.88}, {"text": "этого", "start": 6.88, "end": 7.26}, {"text": "нет.", "start": 7.26, "end": 7.58}, {"text": "Хорошо.", "start": 7.84, "end": 8.2}]}