{"file": "public/audio/lesson80-1-3/raw/2f203bda934a4f.mp3", "id": "80-1-3-032", "take": 1, "model": "whisper-medium", "text": "Верно, а Коран учит верить в Аллаха и в то, чего мы не видим, но о чём он сообщил? Хорошо.", "words": [{"text": "Верно,", "start": 0.0, "end": 0.66}, {"text": "а", "start": 0.92, "end": 1.04}, {"text": "Коран", "start": 1.04, "end": 1.3}, {"text": "учит", "start": 1.3, "end": 1.62}, {"text": "верить", "start": 1.62, "end": 1.98}, {"text": "в", "start": 1.98, "end": 2.18}, {"text": "Аллаха", "start": 2.18, "end": 2.62}, {"text": "и", "start": 2.62, "end": 2.92}, {"text": "в", "start": 2.92, "end": 3.04}, {"text": "то,", "start": 3.04, "end": 3.18}, {"text": "чего", "start": 3.2, "end": 3.42}, {"text": "мы", "start": 3.42, "end": 3.7}, {"text": "не", "start": 3.7, "end": 3.92}, {"text": "видим,", "start": 3.92, "end": 4.18}, {"text": "но", "start": 4.46, "end": 4.6}, {"text": "о", "start": 4.6, "end": 4.74}, {"text": "чём", "start": 4.74, "end": 4.94}, {"text": "он", "start": 4.94, "end": 5.16}, {"text": "сообщил?", "start": 5.16, "end": 5.68}, {"text": "Хорошо.", "start": 5.92, "end": 6.22}]}