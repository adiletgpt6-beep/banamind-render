{"file": "public/audio/lesson80-1-3/raw/50ccd5d3b19ea0.mp3", "id": "80-1-3-013", "take": 2, "model": "whisper-medium", "text": "Сам воздух здесь не виден, но мы замечаем его движение. Вертушка вращается, а кожа чувствует ветерок. Хорошо.", "words": [{"text": "Сам", "start": 0.0, "end": 0.36}, {"text": "воздух", "start": 0.36, "end": 0.78}, {"text": "здесь", "start": 0.78, "end": 1.02}, {"text": "не", "start": 1.02, "end": 1.24}, {"text": "виден,", "start": 1.24, "end": 1.68}, {"text": "но", "start": 1.98, "end": 2.1}, {"text": "мы", "start": 2.1, "end": 2.32}, {"text": "замечаем", "start": 2.32, "end": 2.86}, {"text": "его", "start": 2.86, "end": 3.1}, {"text": "движение.", "start": 3.1, "end": 3.78}, {"text": "Вертушка", "start": 4.0, "end": 4.48}, {"text": "вращается,", "start": 4.48, "end": 5.4}, {"text": "а", "start": 5.58, "end": 5.8}, {"text": "кожа", "start": 5.8, "end": 6.22}, {"text": "чувствует", "start": 6.22, "end": 6.72}, {"text": "ветерок.", "start": 6.72, "end": 7.36}, {"text": "Хорошо.", "start": 7.44, "end": 7.8}]}