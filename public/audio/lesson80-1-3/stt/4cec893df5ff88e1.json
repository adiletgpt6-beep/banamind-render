{"file": "public/audio/lesson80-1-3/80-1-3-013.mp3", "id": "80-1-3-013", "take": null, "model": "whisper-medium", "text": "Сам воздух здесь не виден, но мы замечаем его движение. Вертушка вращается, а кожа чувствует ветерок.", "words": [{"text": "Сам", "start": 0.0, "end": 0.4}, {"text": "воздух", "start": 0.4, "end": 0.86}, {"text": "здесь", "start": 0.86, "end": 1.14}, {"text": "не", "start": 1.14, "end": 1.34}, {"text": "виден,", "start": 1.34, "end": 1.88}, {"text": "но", "start": 2.14, "end": 2.26}, {"text": "мы", "start": 2.26, "end": 2.46}, {"text": "замечаем", "start": 2.46, "end": 3.06}, {"text": "его", "start": 3.06, "end": 3.28}, {"text": "движение.", "start": 3.28, "end": 4.08}, {"text": "Вертушка", "start": 4.32, "end": 4.82}, {"text": "вращается,", "start": 4.82, "end": 5.78}, {"text": "а", "start": 6.02, "end": 6.22}, {"text": "кожа", "start": 6.22, "end": 6.52}, {"text": "чувствует", "start": 6.52, "end": 7.04}, {"text": "ветерок.", "start": 7.04, "end": 7.54}]}