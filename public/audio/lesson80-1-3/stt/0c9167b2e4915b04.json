{"file": "public/audio/lesson80-1-3/raw/ad8144326d6589.mp3", "id": "80-1-3-028", "take": 0, "model": "whisper-medium", "text": "Только то, что воздух может двигаться, хотя мы его не видим, а из слов «я не вижу» ещё не следует этого нет. Хорошо.", "words": [{"text": "Только", "start": 0.0, "end": 0.5}, {"text": "то,", "start": 0.5, "end": 0.7}, {"text": "что", "start": 0.84, "end": 0.92}, {"text": "воздух", "start": 0.92, "end": 1.34}, {"text": "может", "start": 1.34, "end": 1.58}, {"text": "двигаться,", "start": 1.58, "end": 2.22}, {"text": "хотя", "start": 2.36, "end": 2.52}, {"text": "мы", "start": 2.52, "end": 2.72}, {"text": "его", "start": 2.72, "end": 2.9}, {"text": "не", "start": 2.9, "end": 3.16}, {"text": "видим,", "start": 3.16, "end": 3.44}, {"text": "а", "start": 3.84, "end": 3.98}, {"text": "из", "start": 3.98, "end": 4.18}, {"text": "слов", "start": 4.18, "end": 4.44}, {"text": "«я", "start": 4.44, "end": 4.78}, {"text": "не", "start": 4.78, "end": 4.98}, {"text": "вижу»", "start": 4.98, "end": 5.54}, {"text": "ещё", "start": 5.54, "end": 5.86}, {"text": "не", "start": 5.86, "end": 6.1}, {"text": "следует", "start": 6.1, "end": 6.64}, {"text": "этого", "start": 6.64, "end": 7.02}, {"text": "нет.", "start": 7.02, "end": 7.38}, {"text": "Хорошо.", "start": 8.26, "end": 8.62}]}