{"file": "public/audio/lesson80-1-3/80-1-3-032.mp3", "id": "80-1-3-032", "take": null, "model": "whisper-medium", "text": "Верно, а Коран учит верить в Аллаха и в то, чего мы не видим, но о чем он сообщил.", "words": [{"text": "Верно,", "start": 0.0, "end": 0.68}, {"text": "а", "start": 0.86, "end": 0.98}, {"text": "Коран", "start": 0.98, "end": 1.22}, {"text": "учит", "start": 1.22, "end": 1.58}, {"text": "верить", "start": 1.58, "end": 1.88}, {"text": "в", "start": 1.88, "end": 2.06}, {"text": "Аллаха", "start": 2.06, "end": 2.46}, {"text": "и", "start": 2.46, "end": 2.64}, {"text": "в", "start": 2.64, "end": 2.78}, {"text": "то,", "start": 2.78, "end": 2.94}, {"text": "чего", "start": 3.1, "end": 3.12}, {"text": "мы", "start": 3.12, "end": 3.38}, {"text": "не", "start": 3.38, "end": 3.6}, {"text": "видим,", "start": 3.6, "end": 3.86}, {"text": "но", "start": 4.08, "end": 4.24}, {"text": "о", "start": 4.24, "end": 4.4}, {"text": "чем", "start": 4.4, "end": 4.5}, {"text": "он", "start": 4.5, "end": 4.74}, {"text": "сообщил.", "start": 4.74, "end": 5.26}]}