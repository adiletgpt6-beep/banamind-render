{"file": "public/audio/lesson80-1-3/raw/e28bdb6e89ee5e.mp3", "id": "80-1-3-013", "take": 1, "model": "whisper-medium", "text": "Сам воздух здесь не виден. Но мы замечаем его движение. Вертушка вращается, а кожа чувствует ветерок. Хорошо.", "words": [{"text": "Сам", "start": 0.0, "end": 0.4}, {"text": "воздух", "start": 0.4, "end": 0.86}, {"text": "здесь", "start": 0.86, "end": 1.12}, {"text": "не", "start": 1.12, "end": 1.34}, {"text": "виден.", "start": 1.34, "end": 1.76}, {"text": "Но", "start": 2.1, "end": 2.24}, {"text": "мы", "start": 2.24, "end": 2.46}, {"text": "замечаем", "start": 2.46, "end": 3.06}, {"text": "его", "start": 3.06, "end": 3.28}, {"text": "движение.", "start": 3.28, "end": 4.06}, {"text": "Вертушка", "start": 4.32, "end": 4.82}, {"text": "вращается,", "start": 4.82, "end": 5.76}, {"text": "а", "start": 6.0, "end": 6.2}, {"text": "кожа", "start": 6.2, "end": 6.5}, {"text": "чувствует", "start": 6.5, "end": 7.04}, {"text": "ветерок.", "start": 7.04, "end": 7.66}, {"text": "Хорошо.", "start": 7.96, "end": 8.26}]}