{"file": "public/audio/lesson80-1-3/raw/f0cd2be2778142.mp3", "id": "80-1-3-010", "take": 0, "model": "whisper-medium", "text": "Ты направил на них воздух. Когда воздух движется, он может вращать вертушку. Хорошо.", "words": [{"text": "Ты", "start": 0.0, "end": 0.24}, {"text": "направил", "start": 0.24, "end": 0.8}, {"text": "на", "start": 0.8, "end": 0.92}, {"text": "них", "start": 0.92, "end": 1.16}, {"text": "воздух.", "start": 1.16, "end": 1.8}, {"text": "Когда", "start": 2.02, "end": 2.24}, {"text": "воздух", "start": 2.24, "end": 2.68}, {"text": "движется,", "start": 2.68, "end": 3.3}, {"text": "он", "start": 3.42, "end": 3.56}, {"text": "может", "start": 3.56, "end": 3.9}, {"text": "вращать", "start": 3.9, "end": 4.34}, {"text": "вертушку.", "start": 4.34, "end": 4.98}, {"text": "Хорошо.", "start": 5.22, "end": 5.62}]}