{"file": "public/audio/lesson80-1-3/raw/fda17902e340f7.mp3", "id": "80-1-3-013", "take": 0, "model": "whisper-medium", "text": "Сам воздух здесь не виден, но мы замечаем его движение. Вертушка вращается, а кожа чувствует ветерок. Хорошо.", "words": [{"text": "Сам", "start": 0.0, "end": 0.44}, {"text": "воздух", "start": 0.44, "end": 0.96}, {"text": "здесь", "start": 0.96, "end": 1.24}, {"text": "не", "start": 1.24, "end": 1.5}, {"text": "виден,", "start": 1.5, "end": 1.88}, {"text": "но", "start": 2.18, "end": 2.32}, {"text": "мы", "start": 2.32, "end": 2.58}, {"text": "замечаем", "start": 2.58, "end": 3.14}, {"text": "его", "start": 3.14, "end": 3.34}, {"text": "движение.", "start": 3.34, "end": 4.04}, {"text": "Вертушка", "start": 4.24, "end": 4.72}, {"text": "вращается,", "start": 4.72, "end": 5.6}, {"text": "а", "start": 5.8, "end": 6.0}, {"text": "кожа", "start": 6.0, "end": 6.3}, {"text": "чувствует", "start": 6.3, "end": 6.8}, {"text": "ветерок.", "start": 6.8, "end": 7.46}, {"text": "Хорошо.", "start": 7.66, "end": 8.04}]}