{
  "version": 1,
  "engine": "elevenlabs",
  "voice": "Eric (ElevenLabs, multilingual v2)",
  "lines": [
    {
      "id": "s1a",
      "file": "s1a.mp3",
      "hash": "b252648a868e4f6d",
      "text": "Вчера было темно.",
      "duration": 1.296,
      "speechStart": 0,
      "speechEnd": 0.964,
      "words": [
        {
          "text": "Вчера",
          "start": 0,
          "end": 0.325
        },
        {
          "text": "было",
          "start": 0.36,
          "end": 0.534
        },
        {
          "text": "темно.",
          "start": 0.569,
          "end": 0.964
        }
      ]
    },
    {
      "id": "s1b",
      "file": "s1b.mp3",
      "hash": "941519d5ac97a0c5",
      "text": "А сегодня снова светло.",
      "duration": 1.704,
      "speechStart": 0,
      "speechEnd": 1.405,
      "words": [
        {
          "text": "А",
          "start": 0,
          "end": 0.093
        },
        {
          "text": "сегодня",
          "start": 0.186,
          "end": 0.522
        },
        {
          "text": "снова",
          "start": 0.569,
          "end": 0.848
        },
        {
          "text": "светло.",
          "start": 0.882,
          "end": 1.405
        }
      ]
    },
    {
      "id": "s1c",
      "file": "s1c.mp3",
      "hash": "4265b73cca235fff",
      "text": "Ты когда-нибудь думал — почему?",
      "duration": 1.992,
      "speechStart": 0,
      "speechEnd": 1.707,
      "words": [
        {
          "text": "Ты",
          "start": 0,
          "end": 0.163
        },
        {
          "text": "когда-нибудь",
          "start": 0.163,
          "end": 0.731
        },
        {
          "text": "думал",
          "start": 0.731,
          "end": 0.975
        },
        {
          "text": "почему?",
          "start": 1.091,
          "end": 1.707
        }
      ]
    },
    {
      "id": "s2a",
      "file": "s2a.mp3",
      "hash": "d81cb1f25797c140",
      "text": "Смотри: Земля вращается.",
      "duration": 2.304,
      "speechStart": 0,
      "speechEnd": 1.927,
      "words": [
        {
          "text": "Смотри:",
          "start": 0,
          "end": 0.546
        },
        {
          "text": "Земля",
          "start": 0.72,
          "end": 1.022
        },
        {
          "text": "вращается.",
          "start": 1.068,
          "end": 1.927
        }
      ]
    },
    {
      "id": "s2b",
      "file": "s2b.mp3",
      "hash": "204285ee61afc8fe",
      "text": "С одной стороны день, с другой — ночь.",
      "duration": 2.904,
      "speechStart": 0,
      "speechEnd": 2.113,
      "words": [
        {
          "text": "С",
          "start": 0,
          "end": 0.104
        },
        {
          "text": "одной",
          "start": 0.163,
          "end": 0.36
        },
        {
          "text": "стороны",
          "start": 0.395,
          "end": 0.778
        },
        {
          "text": "день,",
          "start": 0.836,
          "end": 1.08
        },
        {
          "text": "с",
          "start": 1.161,
          "end": 1.207
        },
        {
          "text": "другой",
          "start": 1.242,
          "end": 1.625
        },
        {
          "text": "ночь.",
          "start": 1.741,
          "end": 2.113
        }
      ]
    },
    {
      "id": "s3a",
      "file": "s3a.mp3",
      "hash": "1d704b07ca84e773",
      "text": "Но Коран предлагает нам не только узнать, как это происходит, но и задуматься о самом творении.",
      "duration": 5.784,
      "speechStart": 0,
      "speechEnd": 5.352,
      "words": [
        {
          "text": "Но",
          "start": 0,
          "end": 0.163
        },
        {
          "text": "Коран",
          "start": 0.209,
          "end": 0.464
        },
        {
          "text": "предлагает",
          "start": 0.511,
          "end": 1.126
        },
        {
          "text": "нам",
          "start": 1.173,
          "end": 1.277
        },
        {
          "text": "не",
          "start": 1.324,
          "end": 1.393
        },
        {
          "text": "только",
          "start": 1.451,
          "end": 1.765
        },
        {
          "text": "узнать,",
          "start": 1.8,
          "end": 2.229
        },
        {
          "text": "как",
          "start": 2.287,
          "end": 2.473
        },
        {
          "text": "это",
          "start": 2.577,
          "end": 2.67
        },
        {
          "text": "происходит,",
          "start": 2.717,
          "end": 3.297
        },
        {
          "text": "но",
          "start": 3.355,
          "end": 3.413
        },
        {
          "text": "и",
          "start": 3.46,
          "end": 3.483
        },
        {
          "text": "задуматься",
          "start": 3.529,
          "end": 4.098
        },
        {
          "text": "о",
          "start": 4.18,
          "end": 4.261
        },
        {
          "text": "самом",
          "start": 4.284,
          "end": 4.621
        },
        {
          "text": "творении.",
          "start": 4.702,
          "end": 5.352
        }
      ]
    },
    {
      "id": "s4a",
      "file": "s4a.mp3",
      "hash": "279b9515893734e7",
      "text": "В суре «Аль-Имран» говорится:",
      "duration": 2.424,
      "speechStart": 0,
      "speechEnd": 2.125,
      "words": [
        {
          "text": "В",
          "start": 0,
          "end": 0.163
        },
        {
          "text": "суре",
          "start": 0.209,
          "end": 0.441
        },
        {
          "text": "«Аль-Имран»",
          "start": 0.441,
          "end": 1.649
        },
        {
          "text": "говорится:",
          "start": 1.649,
          "end": 2.125
        }
      ]
    },
    {
      "id": "s4b",
      "file": "s4b.mp3",
      "hash": "dddebb85ad329c8f",
      "text": "небо, земля и смена дня и ночи — знамения для людей, которые размышляют.",
      "duration": 5.76,
      "speechStart": 0,
      "speechEnd": 5.399,
      "words": [
        {
          "text": "небо,",
          "start": 0,
          "end": 0.58
        },
        {
          "text": "земля",
          "start": 0.731,
          "end": 1.173
        },
        {
          "text": "и",
          "start": 1.254,
          "end": 1.277
        },
        {
          "text": "смена",
          "start": 1.312,
          "end": 1.718
        },
        {
          "text": "дня",
          "start": 1.753,
          "end": 2.043
        },
        {
          "text": "и",
          "start": 2.136,
          "end": 2.183
        },
        {
          "text": "ночи",
          "start": 2.241,
          "end": 2.601
        },
        {
          "text": "знамения",
          "start": 2.821,
          "end": 3.286
        },
        {
          "text": "для",
          "start": 3.344,
          "end": 3.471
        },
        {
          "text": "людей,",
          "start": 3.518,
          "end": 3.959
        },
        {
          "text": "которые",
          "start": 4.272,
          "end": 4.632
        },
        {
          "text": "размышляют.",
          "start": 4.667,
          "end": 5.399
        }
      ]
    },
    {
      "id": "s5a",
      "file": "s5a.mp3",
      "hash": "0bf065e00c2ce579",
      "text": "Что такое знамение?",
      "duration": 1.752,
      "speechStart": 0,
      "speechEnd": 1.207,
      "words": [
        {
          "text": "Что",
          "start": 0,
          "end": 0.221
        },
        {
          "text": "такое",
          "start": 0.279,
          "end": 0.546
        },
        {
          "text": "знамение?",
          "start": 0.58,
          "end": 1.207
        }
      ]
    },
    {
      "id": "s5b",
      "file": "s5b.mp3",
      "hash": "032fcc58a979b068",
      "text": "Это то, что помогает нам остановиться, посмотреть вокруг и задуматься об Аллахе.",
      "duration": 5.136,
      "speechStart": 0,
      "speechEnd": 4.772,
      "words": [
        {
          "text": "Это",
          "start": 0,
          "end": 0.279
        },
        {
          "text": "то,",
          "start": 0.337,
          "end": 0.441
        },
        {
          "text": "что",
          "start": 0.488,
          "end": 0.604
        },
        {
          "text": "помогает",
          "start": 0.65,
          "end": 1.149
        },
        {
          "text": "нам",
          "start": 1.207,
          "end": 1.324
        },
        {
          "text": "остановиться,",
          "start": 1.37,
          "end": 2.194
        },
        {
          "text": "посмотреть",
          "start": 2.252,
          "end": 2.786
        },
        {
          "text": "вокруг",
          "start": 2.833,
          "end": 3.286
        },
        {
          "text": "и",
          "start": 3.367,
          "end": 3.402
        },
        {
          "text": "задуматься",
          "start": 3.483,
          "end": 4.052
        },
        {
          "text": "об",
          "start": 4.098,
          "end": 4.18
        },
        {
          "text": "Аллахе.",
          "start": 4.261,
          "end": 4.772
        }
      ]
    },
    {
      "id": "s6a",
      "file": "s6a.mp3",
      "hash": "41e249ee938356b4",
      "text": "Верующие говорят:",
      "duration": 1.344,
      "speechStart": 0,
      "speechEnd": 1.045,
      "words": [
        {
          "text": "Верующие",
          "start": 0,
          "end": 0.569
        },
        {
          "text": "говорят:",
          "start": 0.627,
          "end": 1.045
        }
      ]
    },
    {
      "id": "s6b",
      "file": "s6b.mp3",
      "hash": "da5f005975cd5d5f",
      "text": "«Господь наш! Ты не сотворил это понапрасну».",
      "duration": 3.048,
      "speechStart": 0.163,
      "speechEnd": 2.728,
      "words": [
        {
          "text": "«Господь",
          "start": 0.163,
          "end": 0.615
        },
        {
          "text": "наш!",
          "start": 0.673,
          "end": 0.929
        },
        {
          "text": "Ты",
          "start": 0.998,
          "end": 1.068
        },
        {
          "text": "не",
          "start": 1.115,
          "end": 1.184
        },
        {
          "text": "сотворил",
          "start": 1.231,
          "end": 1.695
        },
        {
          "text": "это",
          "start": 1.753,
          "end": 1.95
        },
        {
          "text": "понапрасну».",
          "start": 1.997,
          "end": 2.728
        }
      ]
    },
    {
      "id": "s7a",
      "file": "s7a.mp3",
      "hash": "124f6baec89a0a1f",
      "text": "А теперь твоя очередь.",
      "duration": 1.8,
      "speechStart": 0,
      "speechEnd": 1.416,
      "words": [
        {
          "text": "А",
          "start": 0,
          "end": 0.104
        },
        {
          "text": "теперь",
          "start": 0.186,
          "end": 0.453
        },
        {
          "text": "твоя",
          "start": 0.476,
          "end": 0.813
        },
        {
          "text": "очередь.",
          "start": 0.906,
          "end": 1.416
        }
      ]
    },
    {
      "id": "s7b",
      "file": "s7b.mp3",
      "hash": "0ed527e0376e42dc",
      "text": "Посмотри на небо.",
      "duration": 1.512,
      "speechStart": 0,
      "speechEnd": 1.149,
      "words": [
        {
          "text": "Посмотри",
          "start": 0,
          "end": 0.592
        },
        {
          "text": "на",
          "start": 0.639,
          "end": 0.708
        },
        {
          "text": "небо.",
          "start": 0.789,
          "end": 1.149
        }
      ]
    },
    {
      "id": "s7c",
      "file": "s7c.mp3",
      "hash": "c8bf185a7a6e9024",
      "text": "Что удивляет тебя больше всего?",
      "duration": 2.088,
      "speechStart": 0,
      "speechEnd": 1.707,
      "words": [
        {
          "text": "Что",
          "start": 0,
          "end": 0.221
        },
        {
          "text": "удивляет",
          "start": 0.267,
          "end": 0.72
        },
        {
          "text": "тебя",
          "start": 0.743,
          "end": 0.998
        },
        {
          "text": "больше",
          "start": 1.045,
          "end": 1.289
        },
        {
          "text": "всего?",
          "start": 1.324,
          "end": 1.707
        }
      ]
    }
  ]
}
