    "three": "^0.180.0"
  },
  "devDependencies": {
    "@fontsource/montserrat": "^5.2.6",
    "@remotion/bundler": "^4.0.532",
    "@remotion/renderer": "^4.0.532",
    "@types/react": "^19.2.7",
