{
 "s1": {
  "duration": 4.725,
  "phrases": [
   {
    "text": "Смотри!",
    "start": 0.0,
    "dur": 0.713
   },
   {
    "text": "Одна маленькая нить.",
    "start": 1.063,
    "dur": 1.342
   },
   {
    "text": "А что из неё можно сплести?",
    "start": 2.855,
    "dur": 1.87
   }
  ]
 },
 "s2": {
  "duration": 7.242,
  "phrases": [
   {
    "text": "Вот наша Земля!",
    "start": 0.0,
    "dur": 1.233
   },
   {
    "text": "Она вращается.",
    "start": 1.583,
    "dur": 1.23
   },
   {
    "text": "Там, где светит Солнце, — день.",
    "start": 3.213,
    "dur": 1.957
   },
   {
    "text": "А на другой стороне — ночь.",
    "start": 5.52,
    "dur": 1.721
   }
  ]
 },
 "s3": {
  "duration": 6.075,
  "phrases": [
   {
    "text": "Теперь взгляни на горы!",
    "start": 0.0,
    "dur": 1.499
   },
   {
    "text": "Высокие вершины,",
    "start": 1.899,
    "dur": 1.354
   },
   {
    "text": "облака и реки —",
    "start": 3.453,
    "dur": 1.076
   },
   {
    "text": "сколько удивительного!",
    "start": 4.779,
    "dur": 1.296
   }
  ]
 },
 "s4": {
  "duration": 7.048,
  "phrases": [
   {
    "text": "А из маленького семечка",
    "start": 0.0,
    "dur": 1.411
   },
   {
    "text": "со временем вырастает дерево.",
    "start": 1.511,
    "dur": 1.891
   },
   {
    "text": "У него появляются ветви",
    "start": 3.853,
    "dur": 1.708
   },
   {
    "text": "и множество листьев.",
    "start": 5.711,
    "dur": 1.337
   }
  ]
 },
 "s5": {
  "duration": 7.84,
  "phrases": [
   {
    "text": "В суре «Аль-Имран» говорится:",
    "start": 0.0,
    "dur": 1.61
   },
   {
    "text": "в сотворении небес и земли,",
    "start": 1.96,
    "dur": 1.814
   },
   {
    "text": "в смене ночи и дня",
    "start": 3.973,
    "dur": 1.336
   },
   {
    "text": "есть знамения для обладающих разумом.",
    "start": 5.509,
    "dur": 2.331
   }
  ]
 },
 "s6": {
  "duration": 5.748,
  "phrases": [
   {
    "text": "И верующие говорят:",
    "start": 0.0,
    "dur": 1.539
   },
   {
    "text": "«Господь наш!",
    "start": 2.089,
    "dur": 1.029
   },
   {
    "text": "Ты не сотворил это понапрасну».",
    "start": 3.569,
    "dur": 2.18
   }
  ]
 },
 "s7": {
  "duration": 3.478,
  "phrases": [
   {
    "text": "А что в мире удивляет тебя?",
    "start": 0.0,
    "dur": 1.695
   },
   {
    "text": "Посмотри вокруг!",
    "start": 2.195,
    "dur": 1.284
   }
  ]
 }
}