{
  "name": "balago-video",
  "version": "1.0.0",
  "description": "BalaGo promo videos (Remotion)",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "dependencies": {
    "@react-three/fiber": "9.8.1",
    "@remotion/cli": "4.0.532",
    "@remotion/fonts": "4.0.532",
    "@remotion/media": "4.0.532",
    "@remotion/paths": "4.0.532",
    "@remotion/three": "4.0.532",
    "@remotion/transitions": "4.0.532",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.532",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@napi-rs/canvas": "1.0.10",
    "@remotion/eslint-config-flat": "4.0.532",
    "@types/react": "19.2.7",
    "@types/three": "0.186.0",
    "@types/web": "0.0.166",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "studio": "remotion studio",
    "typecheck": "tsc",
    "lint": "eslint src && tsc",
    "bundle": "remotion bundle",
    "build": "remotion bundle",
    "render": "remotion render BalaGoPromo out/balago-promo.mp4 --codec=h264 --pixel-format=yuv420p --color-space=bt709",
    "stills": "node scripts/render-stills.mjs",
    "check": "npm run lint",
    "upgrade": "remotion upgrade",
    "audio:music": "node scripts/generate-music.mjs",
    "test:audio": "node --test scripts/*.test.mjs",
    "audio:voice": "node scripts/generate-voice.mjs",
    "render:driver": "remotion render BalaGoDriverIntro out/balago-driver-intro.mp4 --codec=h264 --pixel-format=yuv420p --color-space=bt709",
    "stills:driver": "node scripts/render-stills.mjs driver-intro",
    "audio:voice:driver": "node scripts/generate-voice.mjs driver-intro",
    "render:how": "remotion render BalaGoHowItWorks out/balago-how-it-works.mp4 --codec=h264 --pixel-format=yuv420p --color-space=bt709",
    "stills:how": "node scripts/render-stills.mjs how-it-works",
    "audio:voice:how": "node scripts/generate-voice.mjs how-it-works",
    "render:morning": "remotion render BalaGoMorningRush out/balago-morning-rush.mp4 --codec=h264 --pixel-format=yuv420p --color-space=bt709",
    "stills:morning": "node scripts/render-stills.mjs morning-rush",
    "audio:voice:morning": "node scripts/generate-voice.mjs morning-rush",
    "audio:music:morning": "node scripts/generate-music.mjs morning",
    "render:founder": "remotion render BalaGoFounderStory out/balago-founder-story.mp4 --codec=h264 --pixel-format=yuv420p --color-space=bt709",
    "stills:founder": "node scripts/render-stills.mjs founder-story",
    "audio:voice:founder": "node scripts/generate-voice.mjs founder-story",
    "audio:music:founder": "node scripts/generate-music.mjs founder",
    "render:trip": "remotion render BalaGoTripQuestions out/balago-trip-questions.mp4 --codec=h264 --pixel-format=yuv420p --color-space=bt709",
    "stills:trip": "node scripts/render-stills.mjs trip-questions",
    "audio:voice:trip": "node scripts/generate-voice.mjs trip-questions",
    "render:story": "remotion render BalaGoMorningStory out/balago-morning-story.mp4 --codec=h264 --pixel-format=yuv420p --color-space=bt709",
    "stills:story": "node scripts/render-story-stills.mjs",
    "audio:voice:story": "node scripts/generate-story-voice.mjs",
    "audio:voice:half-hour": "node scripts/generate-hh-voice.mjs",
    "test:half-hour": "node --test scripts/half-hour.test.mjs",
    "audio:music:story": "node scripts/generate-music.mjs story"
  },
  "engines": {
    "node": ">=22.18"
  }
}
