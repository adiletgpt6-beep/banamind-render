{
  "voice": {
    "engine": "piper",
    "model": "ru_RU-ruslan-medium",
    "lengthScale": 1.12,
    "noiseScale": 0.62,
    "noiseW": 0.75
  },
  "phrases": [
    {
      "id": "p01",
      "scene": "s1",
      "start": 0.4,
      "end": 3.825,
      "duration": 3.425,
      "text": "Представь: открываешь книгу — а внутри целый удивительный мир!"
    },
    {
      "id": "p02",
      "scene": "s2",
      "start": 6.45,
      "end": 7.762,
      "duration": 1.312,
      "text": "Смотри! Вот Земля."
    },
    {
      "id": "p03",
      "scene": "s2",
      "start": 8.4,
      "end": 12.324,
      "duration": 3.924,
      "text": "Она вращается, поэтому на одной стороне день, а на другой — ночь."
    },
    {
      "id": "p04",
      "scene": "s3",
      "start": 14.75,
      "end": 16.015,
      "duration": 1.266,
      "text": "Перевернём страницу."
    },
    {
      "id": "p05",
      "scene": "s3",
      "start": 16.55,
      "end": 20.505,
      "duration": 3.955,
      "text": "Из плоской бумаги поднимаются горы, облака и широкие реки."
    },
    {
      "id": "p06",
      "scene": "s4",
      "start": 24.9,
      "end": 26.723,
      "duration": 1.823,
      "text": "А здесь маленькое семечко."
    },
    {
      "id": "p07",
      "scene": "s4",
      "start": 27.25,
      "end": 29.688,
      "duration": 2.438,
      "text": "После дождя из него появляется росток."
    },
    {
      "id": "p08",
      "scene": "s4",
      "start": 30.35,
      "end": 32.811,
      "duration": 2.461,
      "text": "Со временем он может стать большим деревом."
    },
    {
      "id": "p09",
      "scene": "s5",
      "start": 35.35,
      "end": 37.335,
      "duration": 1.985,
      "text": "Почему в мире столько удивительного?"
    },
    {
      "id": "p10",
      "scene": "s5",
      "start": 38.1,
      "end": 40.271,
      "duration": 2.171,
      "text": "В суре «Аль-Имран» говорится:"
    },
    {
      "id": "p11",
      "scene": "s5",
      "start": 40.55,
      "end": 44.822,
      "duration": 4.272,
      "text": "в сотворении небес и земли, в смене дня и ночи есть знамения для размышляющих."
    },
    {
      "id": "p12",
      "scene": "s6",
      "start": 46.3,
      "end": 47.554,
      "duration": 1.254,
      "text": "И верующие говорят:"
    },
    {
      "id": "p13",
      "scene": "s6",
      "start": 48.0,
      "end": 51.077,
      "duration": 3.077,
      "text": "«Господь наш! Ты не сотворил это понапрасну»."
    },
    {
      "id": "p14",
      "scene": "s7",
      "start": 53.95,
      "end": 55.343,
      "duration": 1.393,
      "text": "Теперь посмотри вокруг."
    },
    {
      "id": "p15",
      "scene": "s7",
      "start": 55.7,
      "end": 58.765,
      "duration": 3.065,
      "text": "Что из творений Аллаха удивляет тебя больше всего?"
    }
  ],
